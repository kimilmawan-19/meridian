{
  "name": "dlmm-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous DLMM LP agent for Meteora on Solana",
  "main": "index.js",
  "bin": {
    "meridian": "cli.js"
  },
  "scripts": {
    "setup": "node setup.js",
    "env:encrypt": "node scripts/envrypt.js encrypt",
    "start": "node index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart meridian --update-env",
    "pm2:logs": "pm2 logs meridian --lines 100",
    "dev": "DRY_RUN=true node index.js",
    "test": "npm run test:syntax",
    "test:syntax": "find . -path ./node_modules -prune -o -name '*.js' -exec node --check {} \\;",
    "test:screen": "node test/test-screening.js",
    "test:briefing": "node test/test-briefing.mjs",
    "test:exit-cooldown": "node test/test-exit-cooldown-fixes.mjs",
    "test:sol-quote": "node test/test-sol-quote-filter.mjs",
    "test:entry-flow": "node test/test-entry-flow-filter.mjs",
    "test:regime-risk": "node test/test-regime-risk.mjs",
    "test:liquidity-collapse": "node test/test-liquidity-collapse.mjs",
    "test:security-hardening": "node test/test-security-hardening.mjs",
    "test:fee-revenue": "node test/test-fee-revenue.mjs",
    "test:trailing-floor": "node test/test-trailing-floor.mjs",
    "test:direct-close": "node test/test-direct-close.mjs",
    "test:telegram-ux": "node test/test-telegram-ux.mjs",
    "test:grace-log": "node test/test-grace-log.mjs",
    "test:pool-cooldown": "node test/test-pool-cooldown-reasons.mjs",
    "test:hivemind-prompt": "node test/test-hivemind-prompt.mjs",
    "test:swap-retry": "node test/test-swap-retry.mjs",
    "test:llm-retry": "node test/test-llm-retry.mjs",
    "test:llm-calls": "node test/test-llm-calls.mjs",
    "test:signal-snapshot": "node test/test-signal-snapshot.mjs",
    "test:housekeeping": "node test/test-housekeeping.mjs",
    "test:agent": "DRY_RUN=true node test/test-agent.js",
    "postinstall": "node scripts/patch-anchor.js",
    "test:orphan-cleanup": "node test/test-orphan-cleanup.mjs",
    "test:deploy-prompt": "node test/test-deploy-prompt.mjs"
  },
  "knip": {
    "ignore": [
      "discord-listener/**"
    ]
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.4",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.3",
    "bs58": "5.0.0",
    "dotenv": "^17.3.1",
    "jsonrepair": "^3.13.3",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
